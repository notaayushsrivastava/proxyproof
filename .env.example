# Neon pooled connection string used by the FastAPI application.
DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<database>?channel_binding=require&sslmode=require

# Optional direct Neon connection for migrations or administrative tasks.
DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<unpooled-host>/<database>?sslmode=require

PGHOST=<pooled-host>
PGHOST_UNPOOLED=<unpooled-host>
PGUSER=<user>
PGDATABASE=<database>
PGPASSWORD=<password>

# Vercel/Neon-compatible aliases.
POSTGRES_URL=${DATABASE_URL}
POSTGRES_URL_NON_POOLING=${DATABASE_URL_UNPOOLED}
POSTGRES_USER=${PGUSER}
POSTGRES_HOST=${PGHOST}
POSTGRES_PASSWORD=${PGPASSWORD}
POSTGRES_DATABASE=${PGDATABASE}
POSTGRES_URL_NO_SSL=postgresql://${PGUSER}:${PGPASSWORD}@${PGHOST}/${PGDATABASE}
POSTGRES_PRISMA_URL=${DATABASE_URL}

# Authentication & security.
SECRET_KEY=replace_with_a_random_secret_at_least_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application policy.
PROTOCOL_VERSION=1
PROOF_VALIDITY_SECONDS=5
DRIFT_WINDOW_SLOTS=1
PAST_DRIFT_SLOTS=12
DEFAULT_RSSI_THRESHOLD=-75
MIN_RSSI_SAMPLES=3

# Runtime and CORS.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8000,http://localhost:3000
ENVIRONMENT=production
LOG_LEVEL=INFO
