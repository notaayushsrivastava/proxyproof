# Database Configuration
POSTGRES_DB=proxyproof
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:your_secure_postgres_password_here@db:5432/proxyproof

# Authentication & Security
SECRET_KEY=generate_a_high_entropy_random_secret_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# BLE & Attendance Protocol Policy
PROTOCOL_VERSION=1
PROOF_VALIDITY_SECONDS=5
DRIFT_WINDOW_SLOTS=1
DEFAULT_RSSI_THRESHOLD=-75
MIN_RSSI_SAMPLES=3

# CORS & Server
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8000,http://localhost:3000
ENVIRONMENT=development
LOG_LEVEL=INFO
